{
  "name": "backrooms",
  "productName": "The Backrooms",
  "description": "A procedurally generated Backrooms horror game where the rooms rearrange whenever you look away.",
  "author": "splat games",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@sparkjsdev/spark": "2.4.0",
    "@types/three": "^0.187.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "lil-gui": "^0.21.0",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "dev.splatgames.backrooms",
    "productName": "The Backrooms",
    "artifactName": "backrooms-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "The Backrooms"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "The Backrooms"
    },
    "portable": {
      "artifactName": "backrooms-${version}-win-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    }
  }
}
